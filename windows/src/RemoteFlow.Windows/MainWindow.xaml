<Window x:Class="RemoteFlow.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteFlow"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#020617"
        Foreground="#F8FAFC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#172554"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#172554"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#273449"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#22D3EE"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0B1222"
                BorderBrush="#1E293B"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,5,4,25">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#2563EB">
                            <TextBlock Text="RF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RemoteFlow" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Windows" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="NAVIGATION" FontSize="10" Foreground="#64748B" FontWeight="Bold" Margin="4,0,4,8"/>
                    <Button Style="{StaticResource NavButton}" Click="Dashboard_Click" Content="▣   Tableau de bord"/>
                    <Button Style="{StaticResource NavButton}" Click="Connection_Click" Content="◉   Connexion"/>
                    <Button Style="{StaticResource NavButton}" Click="Files_Click" Content="▤   Fichiers"/>
                    <Button Style="{StaticResource NavButton}" Click="Screens_Click" Content="▦   Multi-écrans"/>
                    <Button Style="{StaticResource NavButton}" Click="Macros_Click" Content="⌘   Macros"/>
                    <Button Style="{StaticResource NavButton}" Click="Whiteboard_Click" Content="✎   Tableau blanc"/>
                    <Button Style="{StaticResource NavButton}" Click="Webcam_Click" Content="◉   Webcam"/>
                    <Button Style="{StaticResource NavButton}" Click="Clipboard_Click" Content="▣   Presse-papiers"/>
                    <Button Style="{StaticResource NavButton}" Click="ActivityLog_Click" Content="☷   Activité"/>
                    <Button Style="{StaticResource NavButton}" Click="Settings_Click" Content="⚙   Paramètres"/>
                </StackPanel>
            </ScrollViewer>

                <Border DockPanel.Dock="Bottom"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="État" FontSize="11" Foreground="#94A3B8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8" Fill="#22D3EE"/>
                            <TextBlock x:Name="ConnectionStatus" Text="Prêt" Margin="7,0,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Text="RemoteFlow Windows • v1.0.0" Foreground="#64748B" FontSize="10" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="PageTitle" Text="Tableau de bord" FontSize="26" FontWeight="Bold"/>
                <TextBlock x:Name="PageSubtitle"
                           Text="Centre de contrôle RemoteFlow Windows."
                           FontSize="13"
                           Foreground="#94A3B8"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid>
                <Grid x:Name="DashboardView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="CPU" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock x:Name="DashboardCpuValue" Text="—" FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                                <TextBlock x:Name="DashboardCpuDetail" Text="Utilisation système" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Column="1" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="RAM" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock x:Name="DashboardRamValue" Text="—" FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                                <TextBlock x:Name="DashboardRamDetail" Text="Mémoire système" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Column="2" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="Clients" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock x:Name="DashboardClientsValue" Text="0" FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                                <TextBlock x:Name="DashboardClientsDetail" Text="Connexions TCP actives" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Column="3" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Presse-papiers" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock x:Name="DashboardClipboardValue" Text="ACTIF" FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                                <TextBlock x:Name="DashboardClipboardStatus" Text="Synchronisation locale" Foreground="#34D399" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="État du bureau distant" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="État réel du serveur Windows et des connexions actives" FontSize="12" Foreground="#94A3B8" Margin="0,5,0,16"/>
                                <Border Height="300" Background="#020617" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="DashboardServerState" Text="Serveur en préparation…" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="DashboardServerInfo" Text="—" Foreground="#94A3B8" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="DashboardDesktopInfo" Text="Aucun client distant connecté." Foreground="#64748B" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#111827" Padding="8,5" Margin="12">
                                            <TextBlock x:Name="DashboardServerBadge" Text="RemoteFlow • serveur" FontSize="11" Foreground="#CBD5E1"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Appairage" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DashboardPairingAddress" FontFamily="Consolas" Foreground="#22D3EE" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="DashboardPairingPin" FontFamily="Consolas" Foreground="#CBD5E1" Margin="0,4,0,12"/>
                                    <Button Content="Gérer la connexion" Click="Connection_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Presse-papiers universel" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DashboardClipboardSecondaryStatus" Text="Surveillance active • texte uniquement" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,7,0,12"/>
                                    <Button Content="Ouvrir le presse-papiers" Click="Clipboard_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="ConnectionView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="QR d'appairage" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Scannez avec l'application Android RemoteFlow" Foreground="#94A3B8" FontSize="12" TextAlignment="Center" Margin="0,6,0,14"/>
                            <Border Width="280" Height="280" Background="White" CornerRadius="12" Padding="10">
                                <Image x:Name="PairingQrImage" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="PairingAddress" FontFamily="Consolas" FontSize="14" Foreground="#22D3EE" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                            <Button Content="Copier l'adresse" Click="CopyPairingAddress_Click" Width="160" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PIN d'appairage" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PairingPin" FontFamily="Consolas" FontSize="34" FontWeight="Bold" Foreground="#22D3EE" Margin="0,10,0,4"/>
                                <TextBlock Text="Le PIN est protégé localement par Windows DPAPI et peut être régénéré." Foreground="#94A3B8" TextWrapping="Wrap"/>
                                <Button Content="Régénérer le PIN" Click="RegeneratePin_Click" Width="170" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Identité Windows" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="ID appareil" Foreground="#64748B" FontSize="11" Margin="0,12,0,2"/>
                                <TextBlock x:Name="PairingDeviceId" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="Empreinte SHA-256 de la clé publique" Foreground="#64748B" FontSize="11" Margin="0,12,0,2"/>
                                <TextBlock x:Name="PairingFingerprint" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PairingSecurityState" Foreground="#34D399" FontSize="12" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Presse-papiers universel" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PairingClipboardStatus" Text="Surveillance locale active • hors Internet" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="Texte uniquement, jusqu'à 1 000 000 caractères. Les événements restent sur le réseau local TCP RemoteFlow." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Sécurité de session" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Identité ECDSA P-256 persistante + signature du hello + stockage DPAPI." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="PairingCompatibilityState" Foreground="#FBBF24" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <Button Content="Activer le verrouillage par appairage" Click="TogglePairingEnforcement_Click" Width="260" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>


                <Grid x:Name="FilesView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Dossier RemoteFlow" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FilesRootPath"
                                           Foreground="#94A3B8"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Actualiser" Click="RefreshFiles_Click" Margin="8,0,0,0" Padding="14,8"/>
                            <Button Grid.Column="2" Content="Ouvrir le dossier" Click="OpenFilesFolder_Click" Margin="8,0,0,0" Padding="14,8"/>
                            <Button Grid.Column="3" Content="Ajouter un fichier" Click="ImportFile_Click" Margin="8,0,0,0" Padding="14,8"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="8">
                        <ListView x:Name="FilesList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="#E2E8F0"
                                  SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nom" DisplayMemberBinding="{Binding Name}" Width="220"/>
                                    <GridViewColumn Header="Chemin" DisplayMemberBinding="{Binding RelativePath}" Width="300"/>
                                    <GridViewColumn Header="Taille (octets)" DisplayMemberBinding="{Binding Size}" Width="120"/>
                                    <GridViewColumn Header="Modifié (UTC)" DisplayMemberBinding="{Binding LastModifiedUtc}" Width="220"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0,14,0,0" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FilesTransferStatus" Text="Aucun transfert en cours." FontSize="12"/>
                                <ProgressBar x:Name="FilesTransferProgress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Height="7"
                                             Margin="0,8,20,0"
                                             Visibility="Collapsed"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Ouvrir" Click="OpenSelectedFile_Click" Margin="8,0,0,0" Padding="14,8"/>
                            <Button Grid.Column="2" Content="Envoyer au téléphone" Click="SendSelectedFile_Click" Margin="8,0,0,0" Padding="14,8"/>
                            <Button Grid.Column="3" Content="Annuler transfert" Click="CancelFileTransfer_Click" Margin="8,0,0,0" Padding="14,8"/>
                            <Button Grid.Column="4" Content="Supprimer" Click="DeleteSelectedFile_Click" Margin="8,0,0,0" Padding="14,8"/>
                        </Grid>
                    </Border>
                </Grid>


                <Grid x:Name="ScreensView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Moniteurs Windows" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ScreensDetectedText"
                                           Text="Détection en cours…"
                                           Foreground="#94A3B8"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Actualiser les écrans"
                                    Click="RefreshScreens_Click"
                                    Padding="14,8"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="8">
                        <ListView x:Name="ScreensList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="#E2E8F0"
                                  SelectionMode="Single"
                                  SelectionChanged="ScreensList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="#" DisplayMemberBinding="{Binding DisplayIndex}" Width="48"/>
                                    <GridViewColumn Header="Écran" DisplayMemberBinding="{Binding Name}" Width="260"/>
                                    <GridViewColumn Header="Identifiant" DisplayMemberBinding="{Binding DeviceName}" Width="170"/>
                                    <GridViewColumn Header="Résolution" DisplayMemberBinding="{Binding Resolution}" Width="130"/>
                                    <GridViewColumn Header="Position" DisplayMemberBinding="{Binding Position}" Width="125"/>
                                    <GridViewColumn Header="Écran principal" DisplayMemberBinding="{Binding PrimaryLabel}" Width="125"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0,14,0,0" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock x:Name="ScreensSelectedText"
                                           Text="Sélectionnez un écran à diffuser."
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="ScreensStreamStatus"
                                           Text="Aucun streaming d’écran actif."
                                           Foreground="#94A3B8"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="FPS" FontSize="10" Foreground="#64748B"/>
                                <ComboBox x:Name="ScreensFpsCombo" Width="78" SelectedIndex="2" Margin="0,4,0,0">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="15"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Largeur max" FontSize="10" Foreground="#64748B"/>
                                <ComboBox x:Name="ScreensWidthCombo" Width="100" SelectedIndex="2" Margin="0,4,0,0">
                                    <ComboBoxItem Content="640"/>
                                    <ComboBoxItem Content="960"/>
                                    <ComboBoxItem Content="1280"/>
                                    <ComboBoxItem Content="1600"/>
                                    <ComboBoxItem Content="1920"/>
                                    <ComboBoxItem Content="2560"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="Qualité JPEG" FontSize="10" Foreground="#64748B"/>
                                <ComboBox x:Name="ScreensQualityCombo" Width="92" SelectedIndex="2" Margin="0,4,0,0">
                                    <ComboBoxItem Content="30"/>
                                    <ComboBoxItem Content="45"/>
                                    <ComboBoxItem Content="60"/>
                                    <ComboBoxItem Content="75"/>
                                    <ComboBoxItem Content="90"/>
                                </ComboBox>
                            </StackPanel>

                            <CheckBox x:Name="CaptureAllScreens"
                                      Grid.Column="4"
                                      Content="Bureau complet"
                                      VerticalAlignment="Bottom"
                                      Foreground="#CBD5E1"
                                      Margin="14,0,8,8"/>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Démarrer"
                                        Click="StartScreenStreaming_Click"
                                        Padding="14,8"
                                        Margin="8,0,0,0"/>
                                <Button Content="Arrêter"
                                        Click="StopScreenStreaming_Click"
                                        Padding="14,8"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>


                <Grid x:Name="MacrosView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,14,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Macros enregistrées" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MacrosCountText"
                                           Text="0 macro"
                                           Foreground="#94A3B8"
                                           Margin="0,5,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Nouvelle" Click="NewMacro_Click" Padding="12,7"/>
                                    <Button Content="Actualiser" Click="RefreshMacros_Click" Padding="12,7" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <ListView x:Name="MacrosList"
                                      Margin="0,14,0,0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="#E2E8F0"
                                      SelectionMode="Single"
                                      SelectionChanged="MacrosList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding StepCount, StringFormat={}{0} étape(s)}"
                                                           Foreground="#64748B"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Nom de la macro" FontSize="11" Foreground="#64748B"/>
                                    <TextBox x:Name="MacroNameTextBox"
                                             MinWidth="260"
                                             FontSize="16"
                                             Padding="8,6"
                                             Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Enregistrer"
                                        Click="SaveMacro_Click"
                                        Padding="14,8"
                                        Margin="12,20,0,0"/>
                                <Button Grid.Column="2"
                                        Content="Exécuter"
                                        Click="RunMacro_Click"
                                        Padding="14,8"
                                        Margin="8,20,0,0"/>
                                <Button Grid.Column="3"
                                        Content="Supprimer"
                                        Click="DeleteMacro_Click"
                                        Padding="14,8"
                                        Margin="8,20,0,0"/>
                                <Button Grid.Column="4"
                                        Content="Arrêter"
                                        Click="StopMacro_Click"
                                        Padding="14,8"
                                        Margin="8,20,0,0"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Row="1" Padding="10">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Type" FontSize="10" Foreground="#64748B"/>
                                        <ComboBox x:Name="MacroStepTypeCombo" SelectedIndex="0" Margin="0,4,8,0">
                                            <ComboBoxItem Content="TOUCHE"/>
                                            <ComboBoxItem Content="RACCOURCI"/>
                                            <ComboBoxItem Content="TEXTE"/>
                                            <ComboBoxItem Content="SOURIS"/>
                                            <ComboBoxItem Content="ATTENTE"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Valeur" FontSize="10" Foreground="#64748B"/>
                                        <TextBox x:Name="MacroStepValueTextBox"
                                                 Margin="0,4,8,0"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 ToolTip="TOUCHE/RACCOURCI : CTRL+S • TEXTE : contenu • SOURIS : LEFT_CLICK ou MOVE:0.5,0.5 • ATTENTE : millisecondes"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Pause après (ms)" FontSize="10" Foreground="#64748B"/>
                                        <TextBox x:Name="MacroStepDelayTextBox"
                                                 Text="0"
                                                 Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3"
                                            Content="Ajouter"
                                            Click="AddMacroStep_Click"
                                            Padding="12,7"
                                            VerticalAlignment="Bottom"/>
                                </Grid>

                                <ListBox x:Name="MacroStepsList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#E2E8F0"
                                         SelectionMode="Single">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#020617"
                                                    BorderBrush="#1E293B"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10"
                                                    Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DelayMs, StringFormat={}Pause: {0} ms}"
                                                               Foreground="#64748B"
                                                               Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Monter" Click="MoveMacroStepUp_Click" Padding="12,7"/>
                                    <Button Content="Descendre" Click="MoveMacroStepDown_Click" Padding="12,7" Margin="8,0,0,0"/>
                                    <Button Content="Supprimer l’étape"
                                            Click="RemoveMacroStep_Click"
                                            Padding="12,7"
                                            Margin="8,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0,14,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Actions autorisées" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Clavier, raccourcis, texte, souris et délais uniquement. Aucun lancement de programme ou commande shell n’est exécuté par les macros."
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                                <TextBlock x:Name="MacroRunStatus"
                                           Text="Sélectionnez une macro ou créez-en une nouvelle."
                                           Foreground="#22D3EE"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                <Grid x:Name="WhiteboardView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tableau blanc" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Dessin natif Windows • synchronisation avec les clients RemoteFlow compatibles"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Tag="#2563EB" Content="●" Foreground="#2563EB" Background="Transparent"
                                        BorderThickness="0" FontSize="20" Padding="5,0" Click="WhiteboardColor_Click"
                                        ToolTip="Bleu"/>
                                <Button Tag="#DC2626" Content="●" Foreground="#DC2626" Background="Transparent"
                                        BorderThickness="0" FontSize="20" Padding="5,0" Click="WhiteboardColor_Click"
                                        ToolTip="Rouge"/>
                                <Button Tag="#16A34A" Content="●" Foreground="#16A34A" Background="Transparent"
                                        BorderThickness="0" FontSize="20" Padding="5,0" Click="WhiteboardColor_Click"
                                        ToolTip="Vert"/>
                                <Button Tag="#F59E0B" Content="●" Foreground="#F59E0B" Background="Transparent"
                                        BorderThickness="0" FontSize="20" Padding="5,0" Click="WhiteboardColor_Click"
                                        ToolTip="Orange"/>
                                <Button Tag="#111827" Content="●" Foreground="#111827" Background="Transparent"
                                        BorderThickness="0" FontSize="20" Padding="5,0" Click="WhiteboardColor_Click"
                                        ToolTip="Noir"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="Épaisseur" FontSize="10" Foreground="#64748B"/>
                                <ComboBox x:Name="WhiteboardThicknessCombo" Width="80" SelectedIndex="2" Margin="0,4,0,0">
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="14"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="3" Content="Annuler" Click="WhiteboardUndo_Click"
                                    Padding="12,8" Margin="10,20,0,0"/>
                            <Button Grid.Column="4" Content="Effacer" Click="WhiteboardClear_Click"
                                    Padding="12,8" Margin="8,20,0,0"/>
                            <Button Grid.Column="5" Content="Exporter PNG" Click="WhiteboardExport_Click"
                                    Padding="12,8" Margin="8,20,0,0"/>
                            <Button Grid.Column="6" Content="Envoyer" Click="WhiteboardSendAll_Click"
                                    Padding="12,8" Margin="8,20,0,0"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="8">
                        <InkCanvas x:Name="WhiteboardCanvas"
                                   Background="White"
                                   EditingMode="Ink"
                                   UseLayoutRounding="True"/>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0,14,0,0" Padding="12">
                        <TextBlock x:Name="WhiteboardStatusText"
                                   Text="Tableau blanc prêt. Dessinez avec la souris ou un stylet."
                                   Foreground="#22D3EE"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
                <Grid x:Name="WebcamView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Caméra Windows" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WebcamDetectedText"
                                           Text="Détection des webcams…"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Caméra" FontSize="10" Foreground="#64748B"/>
                                <ComboBox x:Name="WebcamDeviceCombo"
                                          Margin="0,4,0,0"
                                          DisplayMemberPath="Name"
                                          SelectedIndex="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="FPS" FontSize="10" Foreground="#64748B"/>
                                <ComboBox x:Name="WebcamFpsCombo" Margin="0,4,0,0" SelectedIndex="2">
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="15"/>
                                    <ComboBoxItem Content="20"/>
                                    <ComboBoxItem Content="30"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="Qualité" FontSize="10" Foreground="#64748B"/>
                                <ComboBox x:Name="WebcamQualityCombo" Margin="0,4,0,0" SelectedIndex="2">
                                    <ComboBoxItem Content="50"/>
                                    <ComboBoxItem Content="60"/>
                                    <ComboBoxItem Content="70"/>
                                    <ComboBoxItem Content="80"/>
                                    <ComboBoxItem Content="90"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="10,0,0,0">
                                <TextBlock Text="Résolution" FontSize="10" Foreground="#64748B"/>
                                <ComboBox x:Name="WebcamResolutionCombo" Margin="0,4,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="640×480"/>
                                    <ComboBoxItem Content="1280×720"/>
                                    <ComboBoxItem Content="1920×1080"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                <Button Content="Actualiser" Click="RefreshWebcams_Click" Padding="12,8"/>
                                <Button Content="Démarrer" Click="StartWebcam_Click" Padding="12,8" Margin="8,0,0,0"/>
                                <Button Content="Arrêter" Click="StopWebcam_Click" Padding="12,8" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="8">
                        <Grid Background="#020617">
                            <Image x:Name="WebcamPreviewImage"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"/>
                            <TextBlock x:Name="WebcamPreviewPlaceholder"
                                       Text="Caméra arrêtée"
                                       Foreground="#64748B"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#111827"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,5"
                                    Margin="12">
                                <TextBlock x:Name="WebcamPreviewInfo"
                                           Text="Aperçu local"
                                           FontSize="11"
                                           Foreground="#CBD5E1"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0,14,0,0" Padding="12">
                        <TextBlock x:Name="WebcamStatusText"
                                   Text="Sélectionnez une webcam puis démarrez la capture."
                                   Foreground="#22D3EE"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Paramètres &amp; sécurité" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Les réglages sont conservés localement dans le profil Windows de l'utilisateur."
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="LOCAL • WINDOWS"
                                               Foreground="#22D3EE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Réseau RemoteFlow" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Port TCP utilisé par le serveur d'écoute."
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               Margin="0,4,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SettingsTcpPortTextBox"
                                                 Width="150"
                                                 HorizontalAlignment="Left"
                                                 Padding="8,6"
                                                 ToolTip="Port entre 1024 et 65535"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="Modification appliquée après redémarrage du serveur RemoteFlow."
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Sécurité d'appairage" FontSize="15" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="SettingsPairingEnforcedCheckBox"
                                              Content="Exiger un appareil appairé avant toute commande distante"
                                              Foreground="#CBD5E1"
                                              Margin="0,12,0,0"/>
                                    <TextBlock Text="Le PIN et l'identité ECDSA P-256 restent gérés par l'espace de sécurité RemoteFlow."
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="24,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Synchronisation" FontSize="15" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="SettingsClipboardSyncCheckBox"
                                              Content="Activer le presse-papiers universel"
                                              Foreground="#CBD5E1"
                                              Margin="0,12,0,0"/>
                                    <TextBlock Text="Texte uniquement. Désactivé, aucun échange de presse-papiers n'est effectué par le serveur."
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="24,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Démarrage Windows" FontSize="15" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="SettingsStartWithWindowsCheckBox"
                                              Content="Lancer RemoteFlow automatiquement avec Windows"
                                              Foreground="#CBD5E1"
                                              Margin="0,12,0,0"/>
                                    <CheckBox x:Name="SettingsLaunchMinimizedCheckBox"
                                              Content="Lancer RemoteFlow réduit"
                                              Foreground="#CBD5E1"
                                              Margin="0,10,0,0"/>
                                    <TextBlock Text="Le démarrage automatique utilise le profil utilisateur Windows et n'exige pas de compte cloud."
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="24,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Enregistrer les paramètres"
                                                Click="SaveSettings_Click"
                                                Padding="14,9"/>
                                        <Button Content="Réinitialiser"
                                                Click="ResetSettings_Click"
                                                Padding="14,9"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsStatusText"
                                               Text="Aucun changement en attente."
                                               Foreground="#22D3EE"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ActivityLogView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Journal d'activité" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActivityLogSummaryText"
                                           Text="Aucun événement"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Catégorie" FontSize="10" Foreground="#64748B"/>
                                <ComboBox x:Name="ActivityLogFilterCombo"
                                          Margin="0,4,0,0"
                                          SelectedIndex="0"
                                          SelectionChanged="ActivityLogFilter_Changed">
                                    <ComboBoxItem Content="Tous"/>
                                    <ComboBoxItem Content="Serveur"/>
                                    <ComboBoxItem Content="Connexion"/>
                                    <ComboBoxItem Content="Commande"/>
                                    <ComboBoxItem Content="Fichier"/>
                                    <ComboBoxItem Content="Webcam"/>
                                    <ComboBoxItem Content="Presse-papiers"/>
                                    <ComboBoxItem Content="Tableau blanc"/>
                                    <ComboBoxItem Content="Écran"/>
                                    <ComboBoxItem Content="Macro"/>
                                    <ComboBoxItem Content="Système"/>
                                    <ComboBoxItem Content="Paramètres"/>
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Actualiser" Click="RefreshActivityLog_Click" Padding="12,8" Margin="10,18,0,0"/>
                            <Button Grid.Column="3" Content="Exporter CSV" Click="ExportActivityLog_Click" Padding="12,8" Margin="8,18,0,0"/>
                            <Button Grid.Column="4" Content="Effacer" Click="ClearActivityLog_Click" Padding="12,8" Margin="8,18,0,0"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="8">
                        <ListView x:Name="ActivityLogList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="#E2E8F0"
                                  SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Heure" DisplayMemberBinding="{Binding LocalTimestamp}" Width="165"/>
                                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Category}" Width="125"/>
                                    <GridViewColumn Header="Source" DisplayMemberBinding="{Binding Source}" Width="120"/>
                                    <GridViewColumn Header="Niveau" DisplayMemberBinding="{Binding Level}" Width="80"/>
                                    <GridViewColumn Header="Événement" DisplayMemberBinding="{Binding Summary}" Width="560"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0,14,0,0" Padding="12">
                        <TextBlock x:Name="ActivityLogStatusText"
                                   Text="Journal local actif. Le contenu du presse-papiers n'est jamais enregistré."
                                   Foreground="#22D3EE"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <StackPanel x:Name="PlaceholderView" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="PlaceholderTitle" Text="Connexion" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PlaceholderText" TextWrapping="Wrap" Foreground="#94A3B8" Margin="0,8,0,18"/>
                            <Button Content="Revenir au tableau de bord" Click="Dashboard_Click" Width="210" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
